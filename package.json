{
  "name": "universal-file-viewer",
  "version": "0.0.7",
  "private": true,
  "description": "Windows local read-only file viewer prototype",
  "scripts": {
    "start": "npm run build:web && node tools/preview-web.cjs",
    "build:web": "node tools/build-renderers.cjs && node tools/build-web.cjs",
    "test:web": "node --test tests/web-site.test.cjs",
    "test": "node --test tests/broker.test.cjs tests/lifecycle.test.cjs tests/resource-guards.test.cjs",
    "test:renderers": "node --test tests/renderers.test.cjs",
    "test:ipc": "node --test tests/ipc.test.cjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-windows.ps1",
    "test:package": "node --test tests/package.test.cjs",
    "test:browser": "node --test tests/browser.test.cjs tests/session-browser.test.cjs",
    "test:reading": "node tools/test-reading.cjs",
    "test:qualification": "node --test tests/qualification.test.cjs",
    "test:qualification:matrix": "node tools/test-qualification.cjs",
    "bench": "node tools/benchmark/run.cjs",
    "bench:summary": "node tools/benchmark/summarize.cjs",
    "bench:concurrent": "node tools/benchmark/concurrent.cjs",
    "bench:pdf-startup": "node tools/benchmark/pdf-reliability.cjs",
    "view": "node tools/view-local.cjs",
    "test:readiness": "node --test tests/readiness.test.cjs tests/local-view.test.cjs"
  },
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "marked": "18.1.3",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.5.438",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
